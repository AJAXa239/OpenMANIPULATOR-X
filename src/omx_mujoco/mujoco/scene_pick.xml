<mujoco model="omx_scene">
  <!-- Scene passed to mujoco_ros2_control as 'mujoco_model'.
       Includes the robot and adds ground, lighting and (later) objects. -->
  <include file="omx.xml"/>

  <statistic center="0.2 0 0.15" extent="0.6"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="2048" offsamples="2"/>
    <global azimuth="140" elevation="-22" offwidth="1600" offheight="1200"/>
    <map znear="0.01" zfar="50"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.34 0.42" rgb2="0.06 0.07 0.09"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.20 0.22 0.24" rgb2="0.26 0.28 0.30" markrgb="0.5 0.5 0.5"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="6 6" reflectance="0.10" specular="0.3" shininess="0.3"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.6 0.4 1.2" dir="-0.5 -0.35 -1" directional="false"
           diffuse="0.7 0.7 0.7" specular="0.35 0.35 0.35" cutoff="60"/>
    <light name="fill" pos="-0.7 -0.6 0.9" dir="0.6 0.5 -0.9" directional="true"
           diffuse="0.35 0.35 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 0" material="groundplane"
          contype="1" conaffinity="1"/>
  </worldbody>

  <worldbody>
    <body name="table" pos="0.18 0 0.02">
      <geom name="table_top" type="box" size="0.075 0.11 0.02" rgba="0.55 0.45 0.35 1"
            contype="1" conaffinity="1" friction="1 0.02 0.001"/>
    </body>
    <body name="cube" pos="0.18 0 0.052">
      <freejoint name="cube_free"/>
      <inertial pos="0 0 0" mass="0.03" diaginertia="4e-6 4e-6 4e-6"/>
      <geom name="cube" type="box" size="0.0125 0.0125 0.0125" rgba="0.85 0.2 0.2 1"
            contype="1" conaffinity="1" friction="2.0 0.05 0.001" solref="0.008 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
