<mujoco model="open_manipulator_x">
  <!-- ==================================================================
       OpenMANIPULATOR-X (ROBOTIS) 4-DOF arm + gripper, prepared for
       mujoco_ros2_control.

       Conventions required by the bridge:
         * every ros2_control command joint has a MJCF actuator with the
           SAME name  (joint1..joint4, gripper_left_joint)
         * the gripper is driven through a fixed tendon 'split'; the right
           finger has no actuator (registered as a passive joint) and is
           kept mirrored by the <equality> constraint.
       Physics come entirely from this file; the URDF only carries the
       ros2_control block + kinematics for TF/MoveIt.
       ================================================================== -->

  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option integrator="implicitfast" cone="elliptic" impratio="10" timestep="0.002"/>

  <asset>
    <material name="omx_dark"  rgba="0.16 0.16 0.18 1" specular="0.55" shininess="0.45" reflectance="0.10"/>
    <material name="omx_grey"  rgba="0.30 0.31 0.34 1" specular="0.50" shininess="0.40" reflectance="0.08"/>

    <mesh name="link1"              file="link1.stl"              scale="0.001 0.001 0.001"/>
    <mesh name="link2"              file="link2.stl"              scale="0.001 0.001 0.001"/>
    <mesh name="link3"              file="link3.stl"              scale="0.001 0.001 0.001"/>
    <mesh name="link4"              file="link4.stl"              scale="0.001 0.001 0.001"/>
    <mesh name="link5"              file="link5.stl"              scale="0.001 0.001 0.001"/>
    <mesh name="gripper_left_palm"  file="gripper_left_palm.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="gripper_right_palm" file="gripper_right_palm.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <default class="omx">
      <joint damping="0.1" armature="0.01" frictionloss="0.02"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="0" density="0" material="omx_dark"/>
      </default>
      <default class="finger">
        <geom type="mesh" contype="1" conaffinity="1" group="0" density="0"
              material="omx_grey" friction="2.2 0.05 0.001" solref="0.008 1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <!-- link1 = fixed base (welded to world) -->
    <body name="link1" pos="0 0 0" childclass="omx">
      <inertial pos="3.0876154e-04 0 -1.2176461e-04" mass="7.9119962e-02"
                fullinertia="1.2505234e-05 2.1898364e-05 1.9267361e-05 0 -1.7855208e-07 0"/>
      <geom mesh="link1" class="visual"/>

      <body name="link2" pos="0.012 0 0">
        <inertial pos="-3.0184870e-04 5.4043684e-04 0.047433464" mass="9.8406837e-02"
                  fullinertia="3.4543422e-05 3.2689329e-05 1.8850320e-05 -1.6031095e-08 -3.8375155e-07 2.8511935e-08"/>
        <joint name="joint1" axis="0 0 1" range="-3.141592653589793 3.141592653589793" actuatorfrcrange="-30 30"/>
        <geom mesh="link2" class="visual" pos="0 0 0.019"/>

        <body name="link3" pos="0 0 0.0595">
          <inertial pos="1.0308393e-02 3.7743363e-04 1.0170197e-01" mass="1.3850917e-01"
                    fullinertia="3.3055381e-04 3.4290447e-04 6.0346498e-05 -9.7940978e-08 -3.8505711e-05 -1.5717516e-06"/>
          <joint name="joint2" axis="0 1 0" range="-1.5 1.5" actuatorfrcrange="-30 30"/>
          <geom mesh="link3" class="visual"/>

          <body name="link4" pos="0.024 0 0.128">
            <inertial pos="9.0909590e-02 3.8929816e-04 2.2413279e-04" mass="1.3274562e-01"
                      fullinertia="3.0654178e-05 2.4230292e-04 2.5155057e-04 -1.2764155e-06 -2.6874417e-07 1.1559550e-08"/>
            <joint name="joint3" axis="0 1 0" range="-1.5 1.4" actuatorfrcrange="-30 30"/>
            <geom mesh="link4" class="visual"/>

            <body name="link5" pos="0.124 0 0">
              <inertial pos="4.4206755e-02 3.6839985e-07 8.9142216e-03" mass="1.4327573e-01"
                        fullinertia="8.0870749e-05 7.5980465e-05 9.3127351e-05 0 -1.0157896e-06 0"/>
              <joint name="joint4" axis="0 1 0" range="-1.7 1.97" actuatorfrcrange="-30 30"/>
              <geom mesh="link5" class="visual"/>

              <site name="ee" pos="0.126 0 0" size="0.006" rgba="0.9 0.2 0.1 1"/>
              <site name="grasp" pos="0.10 0 0" size="0.004" rgba="0.1 0.9 0.2 1"/>

              <body name="gripper_left_link" pos="0.0817 0.021 0">
                <inertial pos="0 0 0" mass="1.0e-03" diaginertia="1e-06 1e-06 1e-06"/>
                <joint name="gripper_left_joint" axis="0 1 0" type="slide" range="-0.011 0.02" actuatorfrcrange="-20 20"/>
                <geom mesh="gripper_left_palm" class="finger"/>
                <geom name="left_pad" type="box" size="0.018 0.005 0.010" pos="0.044 -0.004 -0.001"
                      rgba="0.05 0.05 0.05 1" contype="1" conaffinity="1"
                      friction="2.5 0.1 0.002" condim="4" solref="0.006 1" solimp="0.95 0.99 0.001"/>
              </body>

              <body name="gripper_right_link" pos="0.0817 -0.021 0">
                <inertial pos="0 0 0" mass="1.0e-03" diaginertia="1e-06 1e-06 1e-06"/>
                <joint name="gripper_right_joint" axis="0 -1 0" type="slide" range="-0.011 0.02"/>
                <geom mesh="gripper_right_palm" class="finger"/>
                <geom name="right_pad" type="box" size="0.018 0.005 0.010" pos="0.044 0.004 -0.001"
                      rgba="0.05 0.05 0.05 1" contype="1" conaffinity="1"
                      friction="2.5 0.1 0.002" condim="4" solref="0.006 1" solimp="0.95 0.99 0.001"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- gripper: one actuator drives tendon 'split'; equality keeps right = left -->
  <tendon>
    <fixed name="split">
      <joint joint="gripper_left_joint"  coef="0.5"/>
      <joint joint="gripper_right_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="gripper_right_joint" joint2="gripper_left_joint" polycoef="0 1 0 0 0"
           solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <actuator>
    <position name="joint1" joint="joint1" kp="150" kv="9"  ctrlrange="-3.14 3.14" forcerange="-30 30"/>
    <position name="joint2" joint="joint2" kp="150" kv="9"  ctrlrange="-1.5 1.5"   forcerange="-30 30"/>
    <position name="joint3" joint="joint3" kp="120" kv="7"  ctrlrange="-1.5 1.4"   forcerange="-30 30"/>
    <position name="joint4" joint="joint4" kp="80"  kv="5"  ctrlrange="-1.7 1.97"  forcerange="-30 30"/>
    <position name="gripper_left_joint" tendon="split" kp="1800" kv="35"
              ctrlrange="-0.011 0.02" forcerange="-60 60"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0 0 0 0" ctrl="0 0 0 0 0"/>
  </keyframe>
</mujoco>
