<?xml version="1.0" ?>
<robot name="open_manipulator_x" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="false"/>
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/><parent link="world"/><child link="link1"/>
  </joint>
  <link name="link1">
    <visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link1.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link1.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="3.0876154e-04 0 -1.2176461e-04"/><mass value="7.9119962e-02"/><inertia ixx="1.2505234e-05" ixy="0" ixz="-1.7855208e-07" iyy="2.1898364e-05" iyz="0" izz="1.9267361e-05"/></inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="link1"/><child link="link2"/><origin rpy="0 0 0" xyz="0.012 0 0"/><axis xyz="0 0 1"/>
    <limit effort="1000" lower="-3.141592653589793" upper="3.141592653589793" velocity="4.8"/><dynamics damping="0.1"/>
  </joint>
  <link name="link2">
    <visual><origin rpy="0 0 0" xyz="0 0 0.019"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link2.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0.019"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link2.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="-3.018487e-04 5.4043684e-04 0.04743346"/><mass value="9.8406837e-02"/><inertia ixx="3.4543422e-05" ixy="-1.6031095e-08" ixz="-3.8375155e-07" iyy="3.2689329e-05" iyz="2.8511935e-08" izz="1.885032e-05"/></inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link2"/><child link="link3"/><origin rpy="0 0 0" xyz="0 0 0.0595"/><axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.5" upper="1.5" velocity="4.8"/><dynamics damping="0.1"/>
  </joint>
  <link name="link3">
    <visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link3.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link3.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="1.0308393e-02 3.7743363e-04 1.0170197e-01"/><mass value="1.3850917e-01"/><inertia ixx="3.3055381e-04" ixy="-9.7940978e-08" ixz="-3.8505711e-05" iyy="3.4290447e-04" iyz="-1.5717516e-06" izz="6.0346498e-05"/></inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link3"/><child link="link4"/><origin rpy="0 0 0" xyz="0.024 0 0.128"/><axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.5" upper="1.4" velocity="4.8"/><dynamics damping="0.1"/>
  </joint>
  <link name="link4">
    <visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link4.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link4.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="9.090959e-02 3.8929816e-04 2.2413279e-04"/><mass value="1.3274562e-01"/><inertia ixx="3.0654178e-05" ixy="-1.2764155e-06" ixz="-2.6874417e-07" iyy="2.4230292e-04" iyz="1.155955e-08" izz="2.5155057e-04"/></inertial>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="link4"/><child link="link5"/><origin rpy="0 0 0" xyz="0.124 0 0"/><axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.7" upper="1.97" velocity="4.8"/><dynamics damping="0.1"/>
  </joint>
  <link name="link5">
    <visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link5.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/link5.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="4.4206755e-02 3.68e-07 8.9142216e-03"/><mass value="1.4327573e-01"/><inertia ixx="8.0870749e-05" ixy="0" ixz="-1.0157896e-06" iyy="7.5980465e-05" iyz="0" izz="9.3127351e-05"/></inertial>
  </link>
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="link5"/><child link="gripper_left_link"/><origin rpy="0 0 0" xyz="0.0817 0.021 0"/><axis xyz="0 1 0"/>
    <limit effort="1000" lower="-0.011" upper="0.02" velocity="4.8"/><dynamics damping="0.1"/>
  </joint>
  <link name="gripper_left_link">
    <visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/gripper_left_palm.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/gripper_left_palm.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="1.0e-03"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial>
  </link>
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="link5"/><child link="gripper_right_link"/><origin rpy="0 0 0" xyz="0.0817 -0.021 0"/><axis xyz="0 -1 0"/>
    <limit effort="1000" lower="-0.011" upper="0.02" velocity="4.8"/><dynamics damping="0.7"/><mimic joint="gripper_left_joint" multiplier="1"/>
  </joint>
  <link name="gripper_right_link">
    <visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/gripper_right_palm.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0"/><geometry><mesh filename="package://omx_mujoco/mujoco/assets/gripper_right_palm.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="1.0e-03"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial>
  </link>
  <joint name="end_effector_joint" type="fixed">
    <parent link="link5"/><child link="end_effector_link"/><origin rpy="0 0 0" xyz="0.126 0 0"/>
  </joint>
  <link name="end_effector_link">
    <visual><origin rpy="0 0 0" xyz="0 0 0"/><geometry><box size="0.01 0.01 0.01"/></geometry><material name="red"><color rgba="1 0 0 1"/></material></visual>
  </link>

  <!-- ================= mujoco_ros2_control ================= -->
  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find omx_mujoco)/mujoco/scene.xml</param>
      <param name="sim_speed_factor">1.0</param>
      <param name="headless">$(arg headless)</param>
    </hardware>
    <joint name="joint1"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint2"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint3"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint4"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="gripper_left_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="gripper_right_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>

    <!-- overhead RGB-D camera. sensor name MUST match the MJCF camera 'overhead' in scene.xml -->
    <sensor name="overhead">
      <param name="frame_name">overhead_optical_frame</param>
      <param name="info_topic">/overhead/color/camera_info</param>
      <param name="image_topic">/overhead/color/image_raw</param>
      <param name="depth_topic">/overhead/aligned_depth_to_color/image_raw</param>
    </sensor>
  </ros2_control>
</robot>
